rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // users collection
    match /users/{userId} {
      // Users may create their own profile; role must NOT be supplied by client.
      // Role assignment is an admin-only operation (use admin callable `assignRole`).
      allow create: if isOwner(userId)
        && incoming().keys().hasAny(['fullName','phoneNumber','barangay'])
        && !incoming().keys().hasAny(['role']);

      // Signed-in users can read user profiles (team coordination needs read access).
      allow read: if isSignedIn();

      // Owner can update limited fields; role change disallowed from client.
      allow update: if isOwner(userId)
        && incoming().role == existing().role
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName','phoneNumber','barangay','status','updatedAt'
        ]);

      allow delete: if false;
    }

    // donations collection
    match /donations/{donationId} {
      // Creation by signed-in donors only; status must start 'pending'
      allow create: if isSignedIn()
        && incoming().donorId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().safetyDeclared == true;

      // Read: signed-in users can read (may be tuned later by role/org)
      allow read: if isSignedIn();

      // Updates: donors can cancel own pending donations (limited fields)
      allow update: if isSignedIn() && (

        // Donor cancelling their pending donation
        (existing().donorId == request.auth.uid
         && existing().status == 'pending'
         && incoming().status == 'cancelled'
         && incoming().diff(existing()).affectedKeys().hasOnly(['status','statusHistory','updatedAt']))

        // Volunteer claiming -> only allow transition pending -> scheduled and volunteerId == request.auth.uid
        || (request.auth.token.role == 'volunteer'
            && existing().status == 'pending'
            && incoming().status == 'scheduled'
            && incoming().volunteerId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status','volunteerId','claimedAt','statusHistory','updatedAt']))

        // Admins or orgAdmins advancing status for assigned organizations
        || (request.auth.token.role in ['orgAdmin','lguAdmin','systemAdmin']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status','pickedUpAt','enRouteAt','deliveredAt','verifiedBy','verifiedAt','statusHistory','updatedAt'
            ]))
      );

      allow delete: if false;
    }

    // qrCodes - tokens representing QR claims; clients may create/read, but
    // must NOT mark codes as used. Only trusted server-side code may update
    // `used`/`usedBy`/`usedAt` fields (server SDK bypasses rules).
    match /qrCodes/{qrId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      // Prevent clients from updating QR documents (server should mark used)
      allow update: if false;
      allow delete: if false;
    }

    // notifications - write only by trusted server (admin claim)
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.recipientUid;
      // Only system admins or back-end services with admin claim may create notifications
      allow create: if isSignedIn() && (request.auth.token.role == 'systemAdmin' || request.auth.token.admin == true);
      allow update, delete: if false;
    }

    // auditLogs - write only by trusted server
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (request.auth.token.role == 'systemAdmin' || request.auth.token.admin == true);
      allow create: if isSignedIn() && (request.auth.token.role == 'systemAdmin' || request.auth.token.admin == true);
      allow update, delete: if false;
    }

    // verificationRequests - created by uploader, updated by admins
    match /verificationRequests/{reqId} {
      allow create: if isSignedIn()
        && incoming().uploaderUid == request.auth.uid
        && incoming().targetUid == request.auth.uid
        && incoming().type in ['volunteer_id', 'org_authorization', 'lgu_authorization']
        && incoming().status == 'pending'
        && incoming().storagePath.matches('authorization-letters/' + request.auth.uid + '/(volunteer-id|organization|lgu)/.*')
        && incoming().keys().hasAll(['requestId','uploaderUid','targetUid','type','storagePath','status','createdAt']);
      allow read: if isSignedIn();
      // Only admins may update review fields
      allow update: if isSignedIn() && (request.auth.token.role in ['orgAdmin','lguAdmin','systemAdmin'] || request.auth.token.admin == true);
      allow delete: if false;
    }

  }
}
