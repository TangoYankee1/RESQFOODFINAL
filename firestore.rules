rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isActive() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == request.auth.token.role;
    }

    function orgMember(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      return hasRole('orgAdmin') && org.status == 'active'
        && (org.primaryContactUid == request.auth.uid || request.auth.uid in org.verifierUids);
    }

    function isAdmin() {
      return isActive() && request.auth.token.role in ['lguAdmin', 'systemAdmin'];
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // users collection — role is server-set only (assignRole callable +
    // signup* callables set custom claims + profile role; clients can never
    // write `role`). Reads scoped: self + admins. Coordination reads for
    // other roles go through donation/org docs, not wholesale profile reads.
    match /users/{userId} {
      allow create: if false;

      allow read: if isOwner(userId) || isAdmin();

      // Owner can update limited non-privileged fields; role/status change
      // disallowed from client (status via setUserStatus callable).
      allow update: if isOwner(userId)
        && incoming().role == existing().role
        && incoming().status == existing().status
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName','barangay','updatedAt'
        ]);

      allow delete: if false;
    }

    // donations collection
    match /donations/{donationId} {
      // All donation creation is validated and audited by createDonorDonation.
      allow create: if false;

      // Scoped reads: pending board (volunteers), own (donor), assigned
      // (volunteer/org), admins. No wholesale reads.
      allow read: if isActive() && (
        (hasRole('volunteer') && existing().status == 'pending')
        || existing().donorId == request.auth.uid
        || existing().get('volunteerId', '') == request.auth.uid
        || (existing().get('orgId', '') != '' && orgMember(existing().orgId))
        || isAdmin()
      );

      // Only optional photo metadata may be patched directly. Commands own status.
      allow update: if isActive() && hasRole('donor')
        && existing().donorId == request.auth.uid && existing().status == 'pending'
        && incoming().diff(existing()).affectedKeys().hasOnly(['imageUrl','updatedAt'])
        && incoming().imageUrl is string;

      allow delete: if false;
    }

    // organizations — org-first accounts; primary contact + admins manage.
    match /organizations/{orgId} {
      allow create: if false;
      allow read: if isSignedIn() && (
        existing().primaryContactUid == request.auth.uid
        || (hasRole('orgAdmin') && request.auth.uid in existing().verifierUids)
        || isAdmin()
      );
      // Validated address/mode changes use the audited server command.
      allow update: if false;
      allow delete: if false;
    }

    // Server-issued PINs: hash-at-rest, 15-min TTL, single-use.
    // Clients never read/write — only issuePin/verifyPin callables.
    match /pins/{pinId} {
      allow read, write: if false;
    }

    // Durable idempotency receipts; no credential or client-writable completion.
    match /handoverReceipts/{receiptId} {
      allow read, write: if false;
    }

    // HMAC QR nonces: server-only. Clients verify via verifyQr callable.
    match /qrNonces/{nonce} {
      allow read, write: if false;
    }

    // Legacy qrCodes docs (unsigned v1): server-only now.
    match /qrCodes/{qrId} {
      allow read, write: if false;
    }

    // notifications — server-written only (notify lib / lifecycle).
    // Recipients read their own.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // auditLogs — server-written only, immutable, admin-readable.
    // (Survives account erasure: anonymized, never deleted.)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // consentRecords (RA 10173): create via recordConsent callable only;
    // read self + admins. Immutable.
    match /consentRecords/{consentId} {
      allow read: if isOwner(existing().uid) || isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // invites: server-issued, single-use, 72h expiry. Validate via callable.
    match /invites/{inviteId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // OTP send ledger: server-only (otpGuard).
    match /otpSends/{sendId} {
      allow read, write: if false;
    }

    // verificationRequests - created by uploader, reviewed by admins
    match /verificationRequests/{reqId} {
      allow create: if isSignedIn()
        && incoming().uploaderUid == request.auth.uid
        && incoming().targetUid == request.auth.uid
        && incoming().type in ['volunteer_id', 'org_authorization', 'lgu_authorization']
        && incoming().status == 'pending'
        && incoming().storagePath.matches('authorization-letters/' + request.auth.uid + '/(volunteer-id|organization|lgu)/.*')
        && incoming().keys().hasAll(['requestId','uploaderUid','targetUid','type','storagePath','status','createdAt']);
      allow read: if isSignedIn() && (
        existing().uploaderUid == request.auth.uid
        || existing().targetUid == request.auth.uid
          || (isAdmin() && hasRole('systemAdmin'))
      );
      // Review decisions go through reviewVerificationRequest callable.
      allow update, delete: if false;
    }

  }
}
