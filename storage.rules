rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Users may upload their own authorization letters to a dedicated folder
    match /authorization-letters/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'systemAdmin' || request.auth.token.admin == true);
    }

    // Donation images: owner can upload; volunteers and admins can read
    match /donation-images/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }

    // User avatars: owner may upload; others may read if signed in
    match /user-avatars/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
