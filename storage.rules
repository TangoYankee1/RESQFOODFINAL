rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isReviewer() {
      return request.auth != null && request.auth.token.role == 'systemAdmin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'systemAdmin'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Users may upload their own authorization letters to a dedicated folder
    match /authorization-letters/{userId}/{allPaths=**} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf'];
      allow update, delete: if false;
      allow read: if request.auth != null && (request.auth.uid == userId || isReviewer());
    }

    // Donation images: path-scoped to the owning donor, MIME + size limited.
    // Volunteers/org/admins read via the donation doc, not bucket listing.
    match /donation-images/{donorId}/{allPaths=**} {
      allow create: if request.auth != null
        && request.auth.uid == donorId
        && request.auth.token.role == 'donor'
        && firestore.get(/databases/(default)/documents/users/$(donorId)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/users/$(donorId)).data.role == 'donor'
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete: if false;
      allow read: if request.auth != null;
    }

    // User avatars: owner may upload; others may read if signed in
    match /user-avatars/{userId}/{allPaths=**} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete: if false;
      allow read: if request.auth != null;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
